# Copy this file to .env and fill in your own keys. Never share the .env file.

# Required for live data: key for the unofficial "IRCTC" API on RapidAPI (host irctc1.p.rapidapi.com)
RAPIDAPI_KEY=

# Optional: RailRadar key (railradar.in). If set, train routes come from RailRadar,
# which saves RapidAPI requests.
RAILRADAR_KEY=
